;; freeboard — an Apple-Freeform-style infinite-canvas board.
;; clj/cljc is the brain (board model + ops); browser/render hosts consume the
;; render-IR as external adapters. kasane imports design files (PSD/PDF/PNG/
;; SVG/…) onto the canvas; kotoba is the content-addressed durable +
;; collaborative layer.
;; See ADR-2606280200.
{:paths ["src" "resources"]

 :deps {org.clojure/clojure       {:mvn/version "1.12.0"}
        ;; engine SDK: scene/ecs/render-IR contract for host adapters
        ;; ADR-2607102200: always depend on standalone kami-engine-sdk,
        ;; never the nested monorepo leftover under kami-engine/.
        io.github.kotoba-lang/kami-engine-sdk {:git/url "https://github.com/kotoba-lang/kami-engine-sdk.git"
                                     :git/sha "03255f3dec8611a060edce79b321872c7945a68a"}
        ;; design-file importer (PSD/PDF/AI/PNG/SVG/Sketch/OOXML/…)
        io.github.kotoba-lang/kasane {:git/url "https://github.com/kotoba-lang/kasane.git"
                                     :git/sha "dca6277cbd2b1781d7e07287a6e003b1f8254a84"}
        ;; viewport interaction math (UIScrollView semantics), ADR-2607071130
        io.github.kotoba-lang/canvaskit {:git/url "https://github.com/kotoba-lang/canvaskit.git"
                                     :git/sha "455f16db6016293452cee0de451d87ef62638dce"}}

 :aliases
 {:malli  {:extra-deps {metosin/malli {:mvn/version "0.16.4"}}}      ; freeboard.schema (validation)
  :test   {:extra-paths ["test"]
           :extra-deps {io.github.cognitect-labs/test-runner
                        {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
           :main-opts ["-m" "cognitect.test-runner"]}
         ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
         :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
           :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                       "--fail-level" "error"]}}}